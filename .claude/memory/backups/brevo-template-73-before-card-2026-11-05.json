{"id":73,"name":"Voucher Purchased","subject":"{% if params.IS_RECIPIENT %}Du hast einen Fermentfreude-Gutschein erhalten 🎁{% else %}Dein Gutschein — {{ params.VOUCHER_CODE }}{% endif %}","isActive":true,"testSent":false,"sender":{"name":"Fermentfreude","email":"kontakt@fermentfreude.at","id":1},"replyTo":"","toField":"","tag":"v2-2026-05","htmlContent":"<!DOCTYPE html>\n<html lang=\"de\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<title>Dein Gutschein</title>\n<style>\n  @media only screen and (max-width:620px){\n    .ff-container{width:100% !important;}\n    .ff-px{padding-left:20px !important;padding-right:20px !important;}\n    .ff-h1{font-size:24px !important;line-height:1.25 !important;}\n    .ff-stack{display:block !important;width:100% !important;}\n    .ff-button a{display:block !important;width:auto !important;}\n  }\n  a{color:#1a1a1a;}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#FFFFFF;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;color:#555251;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#FFFFFF;\">{% if params.IS_RECIPIENT %}{{ params.PURCHASER_NAME | default: \"Jemand\" }} schenkt dir einen Fermentfreude Workshop-Gutschein 🎁{% else %}{{ params.VOUCHER_AMOUNT | default: \"99\" }} € Gutschein — Code {{ params.VOUCHER_CODE | default: \"\" }}{% endif %}</div>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;background-color:#FFFFFF;\">\n  <tr>\n    <td align=\"center\" style=\"padding:0;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" class=\"ff-container\" style=\"border-collapse:collapse;width:600px;max-width:600px;background-color:#FFFFFF;\">\n        <tr>\n  <td style=\"padding:0;background-color:#ffffff;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n      <tr>\n        <td align=\"center\" style=\"padding:36px 24px 28px 24px;background-color:#ffffff;\">\n          <a href=\"https://www.fermentfreude.at\" style=\"text-decoration:none;border:0;outline:none;\">\n            <img src=\"https://pub-c70f47169a1846d79fdab1a41ed2dc7f.r2.dev/media/fermentfreude-logo-email.png\" alt=\"Fermentfreude\" width=\"120\" height=\"116\" style=\"width:120px;height:auto;display:block;margin:0 auto;\" />\n          </a>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"height:3px;line-height:3px;font-size:0;background-color:#E5B765;\">&nbsp;</td>\n      </tr>\n    </table>\n  </td>\n</tr>\n        <tr><td style=\"height:24px;line-height:24px;font-size:0;background-color:#FFFFFF;\">&nbsp;</td></tr>\n        \n<tr><td class=\"ff-px\" align=\"center\" style=\"padding:8px 32px 8px 32px;\">\n    <h1 class=\"ff-h1\" style=\"margin:0;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:28px;line-height:1.2;color:#1a1a1a;font-weight:700;letter-spacing:-0.01em;\">{% if params.IS_RECIPIENT %}Du hast ein Geschenk! 🎁{% else %}Dein Gutschein ist bereit{% endif %}</h1>\n  </td></tr>\n  <tr><td class=\"ff-px\" align=\"center\" style=\"padding:12px 32px 24px 32px;\">\n    <p style=\"margin:0;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:16px;line-height:1.6;color:#555251;\">{% if params.IS_RECIPIENT %}Hey {{ params.FIRST_NAME | default: \"du Glückliche:r\" }}, du hast Glück! 🎁 {{ params.PURCHASER_NAME | default: \"Jemand\" }} möchte dir eine Freude machen und schenkt dir diesen Gutschein für einen Fermentfreude-Workshop.{% if params.PERSONAL_NOTE %}<br><br><em style=\"color:#8a8783;\">&bdquo;{{ params.PERSONAL_NOTE }}&ldquo;</em>{% endif %}{% else %}Hi {{ params.FIRST_NAME | default: \"liebe Genießer:in\" }}, danke für deinen Kauf. Hier ist dein Fermentfreude-Gutschein zum Verschenken oder selbst Genießen.{% endif %}</p>\n  </td></tr>\n\n<!-- Voucher card -->\n<tr><td class=\"ff-px\" style=\"padding:0 32px;\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;background-color:#E5B765;border-radius:8px;\">\n    <tr><td align=\"center\" style=\"padding:28px 24px 8px 24px;\">\n      <img src=\"https://pub-0cf8a1c18a2f4f6b982dbbbf233430a5.r2.dev/media/email/gift-dark.png\" alt=\"\" width=\"40\" height=\"40\" style=\"display:block;border:0;width:40px;height:40px;margin:0 auto;\" />\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:6px 24px 4px 24px;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:12px;line-height:1.3;color:#1a1a1a;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;\">\n      Gutscheinwert\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:0 24px 16px 24px;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:36px;line-height:1.1;color:#1a1a1a;font-weight:700;letter-spacing:-0.01em;\">\n      {{ params.VOUCHER_AMOUNT | default: \"99\" }} €\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:0 24px 8px 24px;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:12px;line-height:1.3;color:#1a1a1a;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;\">\n      Code\n    </td></tr>\n    <tr><td align=\"center\" style=\"padding:0 24px 28px 24px;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:24px;line-height:1.2;color:#1a1a1a;font-weight:700;letter-spacing:0.12em;font-family:'Courier New',Courier,monospace;\">\n      {{ params.VOUCHER_CODE | default: \"—\" }}\n    </td></tr>\n  </table>\n</td></tr>\n<tr><td style=\"height:16px;line-height:16px;font-size:0;\">&nbsp;</td></tr>\n\n<!-- PDF download -->\n{% if params.PDF_DOWNLOAD_URL %}\n<tr><td class=\"ff-px\" align=\"center\" style=\"padding:8px 32px 4px 32px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"ff-button\" style=\"border-collapse:collapse;margin:0 auto;\">\n    <tr>\n      <td align=\"center\" bgcolor=\"#1a1a1a\" style=\"border-radius:6px;background-color:#1a1a1a;\">\n        <a href=\"{{ params.PDF_DOWNLOAD_URL }}\" style=\"display:inline-block;padding:14px 32px;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:15px;font-weight:700;letter-spacing:0.02em;color:#ffffff;text-decoration:none;border-radius:6px;\">Gutschein als PDF herunterladen</a>\n      </td>\n    </tr>\n  </table></td></tr>\n<tr><td class=\"ff-px\" align=\"center\" style=\"padding:6px 32px 20px 32px;\">\n    <p style=\"margin:0;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.5;color:#8a8783;\">Zum Ausdrucken und Verschenken.</p>\n  </td></tr>\n{% endif %}\n\n<tr><td class=\"ff-px\" style=\"padding:0 32px;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;background-color:#ffffff;border:1px solid #E8DFD0;border-radius:8px;\">\n      \n  <tr>\n    <td style=\"padding:14px 20px;border-bottom:1px solid #E8DFD0;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n        <tr>\n          <td width=\"40\" valign=\"middle\" style=\"padding-right:12px;\">\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n              <tr>\n                <td align=\"center\" valign=\"middle\" width=\"36\" height=\"36\" style=\"width:36px;height:36px;background-color:#E5B765;border-radius:50%;\">\n                  <img src=\"https://pub-0cf8a1c18a2f4f6b982dbbbf233430a5.r2.dev/media/email/shopping-cart-white.png\" alt=\"\" width=\"20\" height=\"20\" style=\"display:block;border:0;width:20px;height:20px;\" />\n                </td>\n              </tr>\n            </table>\n          </td>\n          <td valign=\"middle\">\n            <div style=\"font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:12px;line-height:1.3;color:#8a8783;text-transform:uppercase;letter-spacing:0.06em;font-weight:600;\">Einlösbar für</div>\n            <div style=\"font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#1a1a1a;font-weight:500;margin-top:2px;\">Alle Workshops auf fermentfreude.at</div>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:14px 20px;border-bottom:1px solid #E8DFD0;\">\n      <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n        <tr>\n          <td width=\"40\" valign=\"middle\" style=\"padding-right:12px;\">\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n              <tr>\n                <td align=\"center\" valign=\"middle\" width=\"36\" height=\"36\" style=\"width:36px;height:36px;background-color:#E5B765;border-radius:50%;\">\n                  <img src=\"https://pub-0cf8a1c18a2f4f6b982dbbbf233430a5.r2.dev/media/email/info-white.png\" alt=\"\" width=\"20\" height=\"20\" style=\"display:block;border:0;width:20px;height:20px;\" />\n                </td>\n              </tr>\n            </table>\n          </td>\n          <td valign=\"middle\">\n            <div style=\"font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:12px;line-height:1.3;color:#8a8783;text-transform:uppercase;letter-spacing:0.06em;font-weight:600;\">So einlösbar</div>\n            <div style=\"font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#1a1a1a;font-weight:500;margin-top:2px;\">Workshop wählen, Termin buchen und Code beim Bezahlen eingeben</div>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n    </table>\n  </td></tr>\n  <tr><td style=\"height:16px;line-height:16px;font-size:0;\">&nbsp;</td></tr>\n\n<tr><td class=\"ff-px\" align=\"center\" style=\"padding:8px 32px 8px 32px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"ff-button\" style=\"border-collapse:collapse;margin:0 auto;\">\n    <tr>\n      <td align=\"center\" bgcolor=\"#E5B765\" style=\"border-radius:6px;background-color:#E5B765;\">\n        <a href=\"{{ params.SHOP_URL | default: \"https://www.fermentfreude.at/workshops\" }}\" style=\"display:inline-block;padding:14px 32px;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:15px;font-weight:700;letter-spacing:0.02em;color:#1a1a1a;text-decoration:none;border-radius:6px;\">Workshops ansehen</a>\n      </td>\n    </tr>\n  </table></td></tr>\n<tr><td style=\"height:16px;line-height:16px;font-size:0;\">&nbsp;</td></tr>\n<tr><td class=\"ff-px\" align=\"center\" style=\"padding:12px 32px 24px 32px;\">\n    <p style=\"margin:0;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.6;color:#8a8783;\">Bewahre diese E-Mail auf — sie enthält deinen Gutscheincode.</p>\n  </td></tr>\n<tr><td style=\"height:8px;line-height:8px;font-size:0;\">&nbsp;</td></tr>\n\n        <tr><td style=\"height:8px;line-height:8px;font-size:0;background-color:#FFFFFF;\">&nbsp;</td></tr>\n        <tr>\n  <td style=\"padding:0;background-color:#ffffff;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n      <!-- Yellow brand border (top) -->\n      <tr>\n        <td style=\"height:3px;line-height:3px;font-size:0;background-color:#E5B765;\">&nbsp;</td>\n      </tr>\n      <!-- Logo -->\n      <tr>\n        <td align=\"center\" style=\"padding:36px 24px 12px 24px;background-color:#ffffff;\">\n          <a href=\"https://www.fermentfreude.at\" style=\"text-decoration:none;border:0;outline:none;\">\n            <img src=\"https://pub-c70f47169a1846d79fdab1a41ed2dc7f.r2.dev/media/fermentfreude-logo-email.png\" alt=\"Fermentfreude\" width=\"120\" height=\"116\" style=\"width:120px;height:auto;display:block;margin:0 auto;\" />\n          </a>\n        </td>\n      </tr>\n      <!-- Email link -->\n      <tr>\n        <td align=\"center\" style=\"padding:0 24px 20px 24px;background-color:#ffffff;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#1a1a1a;font-weight:700;letter-spacing:0.01em;\">\n          <a href=\"mailto:kontakt@fermentfreude.at\" style=\"color:#1a1a1a;text-decoration:none;font-weight:700;\">kontakt@fermentfreude.at</a>\n        </td>\n      </tr>\n      <!-- Yellow accent divider -->\n      <tr>\n        <td align=\"center\" style=\"padding:0 24px;background-color:#ffffff;\">\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n            <td style=\"width:48px;height:2px;line-height:2px;font-size:0;background-color:#E5B765;\">&nbsp;</td>\n          </tr></table>\n        </td>\n      </tr>\n      <!-- Social icons (Instagram + Facebook — verified real URLs) -->\n      <tr>\n        <td align=\"center\" style=\"padding:20px 24px 24px 24px;background-color:#ffffff;\">\n          <a href=\"https://www.instagram.com/fermentfreude/\" style=\"display:inline-block;margin:0 8px;text-decoration:none;border:0;\">\n            <img src=\"https://pub-0cf8a1c18a2f4f6b982dbbbf233430a5.r2.dev/media/email/instagram.png\" alt=\"Instagram\" width=\"28\" height=\"28\" style=\"display:block;border:0;outline:none;width:28px;height:28px;\" />\n          </a>\n          <a href=\"https://www.facebook.com/people/Ferment-Freude/100087329564765/\" style=\"display:inline-block;margin:0 8px;text-decoration:none;border:0;\">\n            <img src=\"https://pub-0cf8a1c18a2f4f6b982dbbbf233430a5.r2.dev/media/email/facebook.png\" alt=\"Facebook\" width=\"28\" height=\"28\" style=\"display:block;border:0;outline:none;width:28px;height:28px;\" />\n          </a>\n        </td>\n      </tr>\n      <!-- Legal links — black bold -->\n      <tr>\n        <td align=\"center\" style=\"padding:0 24px 20px 24px;background-color:#ffffff;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.6;color:#1a1a1a;font-weight:700;letter-spacing:0.02em;\">\n          <a href=\"https://www.fermentfreude.at/datenschutz\" style=\"color:#1a1a1a;text-decoration:none;font-weight:700;\">Datenschutz</a>\n          <span style=\"color:#E5B765;font-weight:700;\">&nbsp;·&nbsp;</span>\n          <a href=\"https://www.fermentfreude.at/agb\" style=\"color:#1a1a1a;text-decoration:none;font-weight:700;\">AGB</a>\n          <span style=\"color:#E5B765;font-weight:700;\">&nbsp;·&nbsp;</span>\n          <a href=\"https://www.fermentfreude.at/impressum\" style=\"color:#1a1a1a;text-decoration:none;font-weight:700;\">Impressum</a>\n        </td>\n      </tr>\n      <!-- Address -->\n      <tr>\n        <td align=\"center\" style=\"padding:0 24px 12px 24px;background-color:#ffffff;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:12px;line-height:1.6;color:#1a1a1a;font-weight:700;letter-spacing:0.02em;\">\n          Fermentfreude OG &middot; Grabenstraße 15, 8010 Graz, Österreich\n        </td>\n      </tr>\n      <!-- Copyright -->\n      <tr>\n        <td align=\"center\" style=\"padding:0 24px 28px 24px;background-color:#ffffff;font-family: 'Neue Haas Grotesk Display Pro', 'Neue Haas Grotesk Text Pro', 'Neue Haas Grotesk', Helvetica, Arial, sans-serif;font-size:11px;line-height:1.5;color:#8a8783;letter-spacing:0.04em;\">\n          &copy; Fermentfreude\n        </td>\n      </tr>\n      <!-- Yellow brand border (bottom) -->\n      <tr>\n        <td style=\"height:3px;line-height:3px;font-size:0;background-color:#E5B765;\">&nbsp;</td>\n      </tr>\n    </table>\n  </td>\n</tr>\n      </table>\n    </td>\n  </tr>\n</table>\n</body>\n</html>","createdAt":"2026-04-29T11:29:25.000Z","modifiedAt":"2026-11-05T13:35:32.000Z","doiTemplate":false}
